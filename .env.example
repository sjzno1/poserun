# PoseRun 环境变量示例
# 复制为 .env 并按需修改（.env 已被 .gitignore 排除，切勿提交）。
# 所有变量均可选；不设置时使用代码内默认值。

# ---------- 首次启动的管理员种子 ----------
# 仅当用户库为空（全新安装首次启动）时创建该管理员。
# 已有用户库不会被覆盖。登录后请立即在界面中修改密码！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- 安全密钥 ----------
# 会话令牌签名密钥：不设置时首次启动随机生成并保存到 data/.auth_secret（权限600）。
# 多实例/容器重建后仍需保持登录态时，请显式注入一个固定的强随机值：
#   python -c "import secrets; print(secrets.token_hex(32))"
# AUTH_SECRET=
# Flask 会话密钥（生产环境务必设置为强随机值）：
# SECRET_KEY=

# ---------- 跨域 ----------
# 允许跨域调用 API 的来源，逗号分隔。默认仅本机开发来源。
# 生产部署请设置为你的站点域名，例如 https://poserun.example.com
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---------- 数据目录（默认均为应用目录下）----------
# POSERUN_DATA_DIR=./data          # SQLite 账号库/历史数据
# POSERUN_UPLOADS_DIR=./uploads    # 上传的视频
# POSERUN_REPORTS_DIR=./reports    # 生成的报告
# POSERUN_BACKUP_DIR=./data/.backups  # 自动备份
# AUTH_DB_PATH=./data/auth.db      # 账号库路径

# ---------- 服务 ----------
# HOST=0.0.0.0
# PORT=8080
# MAX_CONTENT_LENGTH=52428800      # 上传体积上限（字节），默认 50MB